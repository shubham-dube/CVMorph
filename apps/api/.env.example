# ── App ────────────────────────────────────────────────────────────────────────
APP_NAME="CV Transformation Platform"
APP_ENV="development"          # development | staging | production
SECRET_KEY="CHANGE_ME_generate_with_openssl_rand_hex_32"
DEBUG=true

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql+asyncpg://cvplatform:cvplatform@localhost:5432/cvplatform"
DATABASE_URL_SYNC="postgresql+psycopg2://cvplatform:cvplatform@localhost:5432/cvplatform"

# ── Redis / Celery ─────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# ── AI Provider ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-REPLACE_ME"
AI_DEFAULT_MODEL="claude-sonnet-4-5"
AI_EXTRACTION_VERSION="v1"

# ── Object Storage (S3-compatible) ─────────────────────────────────────────────
STORAGE_BACKEND="local"        # local | s3 | gcs
AWS_ACCESS_KEY_ID="REPLACE_ME"
AWS_SECRET_ACCESS_KEY="REPLACE_ME"
AWS_S3_BUCKET="cv-platform-dev"
AWS_S3_REGION="us-east-1"
LOCAL_STORAGE_PATH="./uploads" # used when STORAGE_BACKEND=local

# ── Auth (JWT) ─────────────────────────────────────────────────────────────────
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Internal org seed ─────────────────────────────────────────────────────────
SEED_ORG_NAME="Copious"
SEED_ADMIN_EMAIL="admin@copious.com"
SEED_ADMIN_PASSWORD="CHANGE_ME_on_first_login"
