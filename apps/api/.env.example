# ── App ────────────────────────────────────────────────────────────────────────
APP_NAME="CV Transformation Platform"
APP_ENV="development"          # development | staging | production
SECRET_KEY="CHANGE_ME_generate_with_openssl_rand_hex_32"
DEBUG=true

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql+asyncpg://cvplatform:cvplatform@localhost:5432/cvplatform"
DATABASE_URL_SYNC="postgresql+psycopg2://cvplatform:cvplatform@localhost:5432/cvplatform"

# ── AI Provider ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-REPLACE_ME"
AI_DEFAULT_MODEL="claude-sonnet-4-5"
AI_EXTRACTION_VERSION="v1"
GEMINI_API_KEY="REPLACE_ME"
GEMINI_MODEL="gemini-2.5-flash"

# ── Object Storage ─────────────────────────────────────────────────────────────
STORAGE_BACKEND="local"        # local | s3 | r2
LOCAL_STORAGE_PATH="./uploads" # used when STORAGE_BACKEND=local

# AWS S3 (optional)
AWS_ACCESS_KEY_ID="REPLACE_ME"
AWS_SECRET_ACCESS_KEY="REPLACE_ME"
AWS_S3_BUCKET="cv-platform-dev"
AWS_S3_REGION="us-east-1"

# Cloudflare R2 (optional)
# R2_ACCOUNT_ID="REPLACE_ME"
# R2_ACCESS_KEY_ID="REPLACE_ME"
# R2_SECRET_ACCESS_KEY="REPLACE_ME"
# R2_BUCKET="cvmorph"
# R2_PUBLIC_URL="https://pub-xxx.r2.dev"

# ── Auth (JWT) ─────────────────────────────────────────────────────────────────
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Internal org seed ─────────────────────────────────────────────────────────
SEED_ORG_NAME="Copious"
SEED_ADMIN_EMAIL="admin@copious.com"
SEED_ADMIN_PASSWORD="CHANGE_ME_on_first_login"
