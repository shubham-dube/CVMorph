{
  "name": "my-copious",
  "private": true,
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=packages/shared-types && npm run build --workspace=apps/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "deploy": "node scripts/deploy.mjs",
    "deploy:dev": "node scripts/deploy.mjs dev",
    "deploy:prod": "node scripts/deploy.mjs prod",
    "deploy:all": "node scripts/deploy.mjs all"
  },
  "workspaces": [
    "apps/web",
    "packages/*"
  ]
}
