{
  "name": "cv-platform",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint && pnpm --filter shared-types build",
    "typecheck": "pnpm --filter web typecheck && pnpm --filter shared-types typecheck",
    "deploy": "node scripts/deploy.mjs",
    "deploy:dev": "node scripts/deploy.mjs dev",
    "deploy:prod": "node scripts/deploy.mjs prod",
    "deploy:all": "node scripts/deploy.mjs all"
  },
  "workspaces": [
    "apps/web",
    "packages/*"
  ]
}
